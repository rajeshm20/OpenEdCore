DB_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=student_db
DATABASE_USER=studentapp
DATABASE_PASSWORD=your_db_password_here
DATABASE_TLS_MODE=disable
AUTO_MIGRATE=true

# TLS & HTTPS
ENABLE_HTTPS=false
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem
TLS_MIN_VERSION=1.2
# TLS_CIPHER_SUITES=ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
# Automated Dev Certificate Renewal (development only; strictly ignored in production)
AUTO_RENEW_DEV_CERTS=true
DEV_CERT_RENEWAL_THRESHOLD_DAYS=30

# HSTS (HTTP Strict Transport Security)
# Defaults: false in development/testing, true in production
HSTS_ENABLED=false
# Safe rollout default: 30 days (2592000s). For 2-year preload list: 63072000
HSTS_MAX_AGE=2592000
# Subdomain protection: requires explicit opt-in after all subdomains support HTTPS
HSTS_INCLUDE_SUBDOMAINS=false
# Browser preload list: requires explicit opt-in, max-age >= 31536000, and includeSubDomains=true
HSTS_PRELOAD=false
# Trust proxy headers (X-Forwarded-Proto): default true behind reverse proxies (Caddy/ALB/Nginx)
TRUST_PROXY_HEADERS=true

JWT_SECRET=your_jwt_secret_at_least_32_characters_long
PASSWORD_RESET_HMAC_SECRET=your_password_reset_hmac_secret_at_least_32_characters_long
ALLOWED_ORIGIN=http://localhost:8081
ENVIRONMENT=development
LOG_LEVEL=info
# Email Configuration
# EMAIL_PROVIDER options: mailpit (recommended for local dev) | brevo | sendgrid | console
# Defaults to Mailpit in development with automatic Console fallback
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_PROVIDER=brevo
MAILPIT_HOST=localhost
MAILPIT_PORT=8025
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@openedschool.com

